# Polymorphism
# Problem: Different Payment Methods

class UPI:
    def pay(self):
        print("Payment through UPI")


class Card:
    def pay(self):
        print("Payment through Card")


class Cash:
    def pay(self):
        print("Payment through Cash")


upi = UPI()
card = Card()
cash = Cash()

upi.pay()
card.pay()
cash.pay()